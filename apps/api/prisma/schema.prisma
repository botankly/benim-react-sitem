datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  role             String   @default("user")
  subscriptionPlan String   @default("free")
  createdAt        DateTime @default(now())
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  price     Float
  stock     Int      @default(0)
  rating    Float    @default(5.0)
  createdAt DateTime @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  userId        String
  userEmail     String
  planName      String
  amount        Float
  date          String
  status        String   @default("Paid")
  paymentMethod String
  createdAt     DateTime @default(now())
}
